# Snowflake Connection Configuration
# Copy this file to .env and fill in your credentials
# Then run: source .env

# Required: Snowflake account identifier (e.g., xy12345.us-east-1)
export SNOWFLAKE_ACCOUNT=

# Required: Snowflake username
export SNOWFLAKE_USER=

# Required: Snowflake password (keep this secure!)
export SNOWFLAKE_PASSWORD=

# Optional: Snowflake warehouse (defaults to COMPUTE_WH if not set)
export SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Optional: Snowflake role (if specific role is needed)
# export SNOWFLAKE_ROLE=ACCOUNTADMIN
